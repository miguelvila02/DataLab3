.PHONY: help install clean test run-dashboard run-api fetch-data train

help: ## show commands
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "%-20s %s\n", $$1, $$2}'

install: ## install dependencies
	pip install -r requirements.txt

clean: ## remove cache files
	rm -rf __pycache__ .pytest_cache .mypy_cache htmlcov .coverage
	find . -name "*.pyc" -delete

clean-all: clean ## remove data and models too
	rm -rf data/ models/

fetch-data: ## generate training data
	python get_data.py

train: ## train the model
	python model_trainer.py

run-dashboard: ## start streamlit
	streamlit run dashboard.py

run-api: ## start api
	uvicorn main:app --reload

test: ## run tests
	pytest tests/ -v

test-cov: ## tests with coverage
	pytest tests/ -v --cov=. --cov-report=html

lint: ## check code
	flake8 . --max-line-length=100 --exclude=venv,build

format: ## format code
	black . --exclude='/(venv|build)/'

docker-build: ## build docker image
	docker build -t pl-predictor .

docker-run: ## run in docker
	docker run -p 8000:8000 pl-predictor

setup: install fetch-data train ## complete setup
	@echo "setup done. run 'make run-dashboard'"

status: ## check what's installed
	@echo "checking status..."
	@if [ -d "venv" ]; then echo "✓ venv exists"; else echo "✗ no venv"; fi
	@if [ -f "data/premier_league_matches.csv" ]; then echo "✓ data exists"; else echo "✗ no data"; fi
	@if [ -f "models/random_forest_model.pkl" ]; then echo "✓ model exists"; else echo "✗ no model"; fi